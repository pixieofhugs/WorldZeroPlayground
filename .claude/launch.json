{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend (FastAPI)",
      "runtimeExecutable": "scripts/wz",
      "runtimeArgs": ["serve"],
      "cwd": "${workspaceRoot}",
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "Frontend (React)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceRoot}/frontend",
      "port": 5173,
      "autoPort": false
    }
  ]
}

# Local overrides for docker-compose.yml. Copy to `.env` (gitignored) only if
# you need to change something — every value below already has a working
# default, so `scripts/wz up` works on a fresh clone with no .env at all.
#
# This file is for the LOCAL world. The deployed environments take their
# configuration from deploy/env.example, filled in on the server and never
# committed.
#
# Each comment sits on its own line, deliberately: docker compose's env_file
# parser does NOT strip a trailing `# ...` from a value, so `SECRET_KEY= # todo`
# hands the app the literal comment text and boots looking fine.

# --- the two that have real defaults ----------------------------------------
# Postgres password for the local db container. Nothing outside your machine
# can reach it (the container publishes 5432 to localhost only).
POSTGRES_PASSWORD=worldzero
# Signs local session cookies. ENVIRONMENT is `development` in the local stack,
# which already opens /auth/dev-login, so this is not protecting anything.
SECRET_KEY=dev-secret-key-not-for-any-deployment

# --- OAuth: only if you are testing a real callback --------------------------
# Blank is correct for normal local work. `scripts/wz login` mints a session
# without any provider, and backend/config.py only requires these when
# ENVIRONMENT=production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

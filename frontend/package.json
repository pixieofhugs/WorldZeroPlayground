{
  "name": "worldzero-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "budget": "node scripts/bundle-budget.mjs",
    "parity": "node scripts/utility-parity.mjs",
    "audit:tailwind": "node scripts/v3-v4-audit/audit.mjs",
    "measure": "node scripts/measure-load.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "typecheck:design-sync": "tsc -p tsconfig.design-sync.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src .ds-kit e2e",
    "e2e": "playwright test",
    "smoke": "playwright test --config playwright.smoke.config.ts",
    "shots": "playwright test --config playwright.shots.config.ts",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "i18next": "^27.1.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.2.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch@^10": "^11.0.5"
  }
}

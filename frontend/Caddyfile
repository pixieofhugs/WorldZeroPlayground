# Serves the built SPA inside the frontend image. This is NOT the edge proxy —
# that one lives in deploy/Caddyfile and terminates TLS in front of this.
:80 {
	root * /srv
	encode gzip zstd

	# Vite content-hashes everything under /assets, so a changed file is a
	# changed URL and these can be cached forever. Same split render.yaml had.
	#
	# Split into its own handle rather than sharing the SPA fallback below: a
	# hashed asset that is genuinely missing has to 404. Falling back to
	# index.html would answer a `<script>` request with HTML, and the browser
	# reports that as a syntax error in the bundle.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is either a real file or client-side routing.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

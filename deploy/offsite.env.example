# Copy to /srv/worldzero/prod/offsite.env on the server, fill in, chmod 600.
# Read only by backup.sh. Never put these in .env: every compose service reads that.
# One comment per line; values are taken literally.
WZ_OFFSITE_ENDPOINT=
WZ_OFFSITE_BUCKET=
WZ_OFFSITE_REGION=
WZ_OFFSITE_KEY_ID=
WZ_OFFSITE_SECRET=

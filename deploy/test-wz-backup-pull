#!/usr/bin/env bash
# Check wz-backup-pull's GitHub reporting without touching prod or GitHub.
#
# The seam is the script as a process: rsync, gh and notify-send are stubs
# first on PATH, and WZ_BACKUP_DIR is a temp directory. Nothing is pulled or
# dispatched. The workflow that acts on the dispatch is
# .github/workflows/backup-pull.yml. Run it: deploy/test-wz-backup-pull
set -uo pipefail

here=$(cd "$(dirname "$0")" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin" "$tmp/dest"

cat >"$tmp/bin/rsync" <<'EOF'
#!/usr/bin/env bash
echo rsync >>"$STUB/calls"
[[ -e "$STUB/rsync-fail" ]] && { echo "stub rsync: connection refused"; exit 12; }
echo "stub rsync: nothing pulled"
EOF
cat >"$tmp/bin/notify-send" <<'EOF'
#!/usr/bin/env bash
echo notify >>"$STUB/calls"
EOF
# gh records the call and its full arguments; $STUB/gh-fail makes it fail.
cat >"$tmp/bin/gh" <<'EOF'
#!/usr/bin/env bash
[[ -e "$STUB/gh-fail" ]] && { echo "stub gh: no network" >&2; exit 1; }
echo "gh $1 $2" >>"$STUB/calls"
printf '%s\n' "$@" >"$STUB/last-args"
EOF
chmod +x "$tmp/bin/"*

fails=0
check() {  # check <description> <command...>
  if "${@:2}"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi
}
calls() { grep -c "^$1\$" "$tmp/calls" 2>/dev/null || true; }
run() {  # run <max age hours>; sets $rc and $out
  rm -f "$tmp/calls" "$tmp/last-args"
  # HOME is the temp directory, so the destination is under it, as it really is.
  out=$(STUB=$tmp HOME=$tmp PATH="$tmp/bin:$PATH" WZ_BOX=nobody@invalid.invalid \
        WZ_BACKUP_DIR="$tmp/dest" WZ_MAX_AGE_HOURS=$1 "$here/wz-backup-pull" 2>&1)
  rc=$?
  # If this ever fails, the real rsync ran. Stop before anything else does.
  [[ $(calls rsync) == 1 ]] || { echo "FAIL the rsync stub was not used"; exit 1; }
}
dispatches() { calls 'gh api repos/pixieofhugs/WorldZeroPlayground/dispatches'; }

echo dump >"$tmp/dest/prod-db-1.dump"
touch -d '3 hours ago' "$tmp/dest/prod-db-1.dump"

# --- red: exactly one dispatch, carrying the payload --------------------------
run 0
check "red: exits 1"                       test "$rc" = 1
check "red: one dispatch"                  test "$(dispatches)" = 1
check "red: no other gh call"              test "$(grep -c '^gh' "$tmp/calls")" = 1
check "red: desktop alert kept"            test "$(calls notify)" = 1
check "event type is backup-pull"          grep -qx 'event_type=backup-pull' "$tmp/last-args"
check "status is red"                      grep -qx 'client_payload\[status\]=red' "$tmp/last-args"
check "payload words the problem"          grep -q 'newest prod dump is 3h old (prod-db-1.dump)' "$tmp/last-args"
check "payload has the newest dump"        grep -qx 'client_payload\[newest\]=prod-db-1.dump, 3h old' "$tmp/last-args"
check "payload has the job's output"       grep -q 'stub rsync: nothing pulled' "$tmp/last-args"
check "payload links RESTORE.md"           grep -q 'deploy/RESTORE.md#' "$tmp/last-args"
check "payload has the run time"           grep -q '^client_payload\[run\]=20' "$tmp/last-args"
# SHOW=1 prints what would have been sent, to read the wording.
[[ -n "${SHOW-}" ]] && sed 's/^/    | /' "$tmp/last-args"

# --- green: one dispatch, status green, exit 0 ----------------------------------
run 26
check "green: exits 0"                     test "$rc" = 0
check "green: one dispatch"                test "$(dispatches)" = 1
check "green: status is green"             grep -qx 'client_payload\[status\]=green' "$tmp/last-args"
check "green: no desktop alert"            test "$(calls notify)" = 0

# --- gh itself failing -----------------------------------------------------------
touch "$tmp/gh-fail"
run 0
check "red, gh down: still exits non-zero"   test "$rc" = 1
check "red, gh down: says it could not report" grep -q 'could not report' <<<"$out"
check "red, gh down: desktop alert kept"     test "$(calls notify)" = 1
# A healthy pull stays healthy: a warning, not a failed unit or a critical alert.
run 26
check "green, gh down: exits 0"              test "$rc" = 0
check "green, gh down: warns"                grep -q 'warning:.*GitHub alarm is not working' <<<"$out"
check "green, gh down: no desktop alert"     test "$(calls notify)" = 0
rm "$tmp/gh-fail"

# --- the pull itself failing, dumps still fresh ------------------------------------
touch "$tmp/rsync-fail"
run 26
check "rsync fails: exits 1"                 test "$rc" = 1
check "rsync fails: payload words the problem"  grep -q 'rsync from nobody@invalid.invalid failed' "$tmp/last-args"
check "rsync fails: payload has rsync's output" grep -q 'stub rsync: connection refused' "$tmp/last-args"
check "rsync fails: advice names ~/dest"     grep -qF '`~/dest`' "$tmp/last-args"
check "rsync fails: no backslash before ~"   bash -c '! grep -qF "\~" "$1"' _ "$tmp/last-args"
rm "$tmp/rsync-fail"

# --- no dump has ever arrived: nothing to restore from -----------------------------
rm "$tmp/dest/prod-db-1.dump"
run 26
check "no dump: exits 1"                     test "$rc" = 1
check "no dump: says there is nothing here"  grep -q 'nothing here to restore from' "$tmp/last-args"
check "no dump: names no newest dump"        bash -c '! grep -q "named above" "$1"' _ "$tmp/last-args"

# --- the box's off-box push failed: backup.sh leaves a marker ----------------------
echo dump >"$tmp/dest/prod-db-1.dump"
printf '2026-11-19 04:00 off-box push failed:\nWZ_OFFSITE_SECRET is not set\n' >"$tmp/dest/offsite-failed.txt"
run 26
check "marker: exits 1"                      test "$rc" = 1
check "marker: payload words the problem"    grep -q 'could not push to the off-box bucket: WZ_OFFSITE_SECRET is not set' "$tmp/last-args"

if ((fails)); then echo "$fails check(s) failed"; exit 1; fi
echo "all checks passed"

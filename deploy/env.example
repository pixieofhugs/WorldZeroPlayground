# Copy to /srv/worldzero/prod/.env (and /srv/worldzero/dev/.env) on the server,
# fill in, `chmod 600`. Never committed, never touched by CI.
#
# Every comment here sits on its own line, deliberately: docker compose's
# env_file parser does NOT strip a trailing `# ...` from a value, so
# `SECRET_KEY=   # generate me` hands production the literal comment text as its
# signing key and boots looking perfectly configured.

# --- which stack this is -----------------------------------------------------
# The dev copy uses worldzero-dev / dev.
COMPOSE_PROJECT_NAME=worldzero-prod
TAG=prod
DOCKERHUB_USERNAME=yourdockerhubuser

# --- secrets -----------------------------------------------------------------
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32 — a different one per environment
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ADMIN_CLI_SECRET=

# --- per-environment URLs ----------------------------------------------------
# prod values shown; the dev copy uses dev.worldzero.org / api.dev.worldzero.org
GOOGLE_REDIRECT_URI=https://api.worldzero.org/auth/google/callback
DISCORD_REDIRECT_URI=https://api.worldzero.org/auth/discord/callback
MEDIA_BASE_URL=https://api.worldzero.org/media
FRONTEND_URL=https://worldzero.org
CORS_ORIGINS=https://worldzero.org,https://www.worldzero.org

# --- fixed -------------------------------------------------------------------
MEDIA_ROOT=/app/media
# `production` in BOTH environments. `development` opens POST /auth/dev-login,
# which mints a session cookie for any caller with no credentials at all
# (backend/routers/auth.py:508). Fine on localhost, account takeover on a public
# hostname. See deploy/README.md.
ENVIRONMENT=production
# COOKIE_DOMAIN stays unset — host-only cookie, same posture as render.yaml.

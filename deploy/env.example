# Copy to /srv/worldzero/prod/.env (and /srv/worldzero/dev/.env) on the server,
# fill in, `chmod 600`. Never committed, never touched by CI.
#
# Every comment here sits on its own line, deliberately: docker compose's
# env_file parser does NOT strip a trailing `# ...` from a value, so
# `SECRET_KEY=   # generate me` hands production the literal comment text as its
# signing key and boots looking perfectly configured.

# --- which stack this is -----------------------------------------------------
# The dev copy uses worldzero-dev / dev.
COMPOSE_PROJECT_NAME=worldzero-prod
TAG=prod
# The GHCR namespace the images are published under — your GitHub owner, lower
# case. Images are public, so the server needs no registry login.
GITHUB_OWNER=pixieofhugs

# --- secrets -----------------------------------------------------------------
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32 — a different one per environment
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ADMIN_CLI_SECRET=

# --- per-environment URLs ----------------------------------------------------
# prod values shown; the dev copy uses dev.worldzero.org / api.dev.worldzero.org
GOOGLE_REDIRECT_URI=https://api.worldzero.org/auth/google/callback
DISCORD_REDIRECT_URI=https://api.worldzero.org/auth/discord/callback
MEDIA_BASE_URL=https://api.worldzero.org/media
FRONTEND_URL=https://worldzero.org
CORS_ORIGINS=https://worldzero.org,https://www.worldzero.org

# --- fixed -------------------------------------------------------------------
MEDIA_ROOT=/app/media
# `production` in BOTH environments, dev included. `development` opens
# POST /auth/dev-login, which mints a valid session cookie for a caller
# supplying no credentials whatsoever, and strips Secure off the cookie besides.
# Harmless on localhost; total account takeover on a public hostname.
#
# If you ever want dev-login on dev.worldzero.org it has to go behind Caddy
# basic_auth on BOTH dev hostnames first — and OAuth callbacks break while it is
# there. The local stack is where that seam belongs (docs/agents/local-world.md).
ENVIRONMENT=production
# COOKIE_DOMAIN stays UNSET, so the session cookie is host-only.
#
# It used to be `.worldzero.org` on Render, which attaches a live 7-day JWT to
# every request to every host under the domain — including dev.worldzero.org.
# With two environments on one domain that is no longer a theoretical leak: a
# wildcard cookie would send prod sessions to the dev box. Leave it unset.
